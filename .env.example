# ==============================================================================
# Harsh Unlimited - Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/harsh_unlimited?schema=public"

# Authentication & Session Security (Generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-secure-random-32-char-secret"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Cashfree Payments (DevStudio / Production)
# Docs: https://www.cashfree.com/devstudio/
# Set CASHFREE_ENV to "SANDBOX" for testing, "PRODUCTION" for live
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_ENV="SANDBOX"
CASHFREE_API_VERSION="2023-08-01"

# Redis Queue (Optional: used for distributed background rank delivery worker)
REDIS_URL="redis://localhost:6379"

# Minecraft Network Endpoints
MINECRAFT_JAVA_HOST="play.harshunlimited.fun"
MINECRAFT_JAVA_PORT="25565"
MINECRAFT_BEDROCK_HOST="play.harshunlimited.fun"
MINECRAFT_BEDROCK_PORT="25565"

# Pterodactyl Panel Integration (Server-side API only)
PTERODACTYL_BASE_URL="https://panel.harshunlimited.fun"
PTERODACTYL_API_KEY="ptla_your_pterodactyl_application_or_client_key"
PTERODACTYL_SERVER_ID="your_minecraft_server_identifier"

# Minecraft In-Game Command Bridge / Plugin (Alternative direct delivery)
MINECRAFT_DELIVERY_BRIDGE_URL="http://127.0.0.1:8080/api/v1/execute"
MINECRAFT_DELIVERY_BRIDGE_SECRET="replace-with-shared-bridge-token"

# Community Links
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/harshunlimited"

# SEO & Google Search Console
GOOGLE_SITE_VERIFICATION="your_google_site_verification_token_here"
