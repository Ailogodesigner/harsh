{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notixnode",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "notixnode"
    }
  ],
  "routes": [
    {
      "pattern": "bot.notixnode.online",
      "custom_domain": true
    }
  ]
}
