{
  "name": "developer-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "deploy": "node ./node_modules/next/dist/bin/next build && node ./node_modules/@opennextjs/cloudflare/dist/cli/index.js build --skipBuild && node ./node_modules/wrangler/bin/wrangler.js deploy --autoconfig=false",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "lint": "eslint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
